includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - src/

    tmpDir: /tmp/wsfq-phpstan

    bootstrapFiles:
        - vendor/autoload.php
        - phpstan-constants.php
        - phpstan-wc.php

    scanDirectories:
        - vendor/php-stubs/wp-cli-stubs/

    stubFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - phpstan-wc.php

    treatPhpDocTypesAsCertain: false

    # PHPStan level is recorded in docs/DECISIONS.md — do not lower it to hide errors.